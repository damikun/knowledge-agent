{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "knowledgedb": "Host=localhost;Port=5432;Database=knowledge;Username=postgres;Password=postgres",
    "clickhouse": "Host=localhost;Port=8123;Username=clickhouse;Password=clickhouse"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Auth": {
    "Mode": "Oidc",
    "Authority": "",
    "MetadataAddress": "",
    "ClientId": "knowledge-agent-portal",
    "ClientSecret": "",
    "PublicOrigin": ""
  },
  "Persistence": {
    "Provider": "Postgres",
    "ConnectionStringName": "knowledgedb",
    "MigrateOnStartup": true
  },
  "VectorStore": {
    "Provider": "ClickHouse",
    "ConnectionStringName": "clickhouse",
    "Database": "knowledge",
    "Table": "chunks",
    "EnsureSchemaOnStartup": true
  },
  "Prompts": {
    "Store": "Langfuse",
    "Label": "production",
    "CacheTtlSeconds": 60,
    "SeedOnStartup": true,
    "FallbackToLocal": true
  },
  "Langfuse": {
    "BaseUrl": "",
    "PublicUrl": "",
    "PublicKey": "",
    "SecretKey": "",
    "Tracing": {
      "Enabled": true
    }
  },
  "Ingestion": {
    "MaxParallelism": 2,
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 60,
    "EmbeddingBatchSize": 64,
    "MaxAttempts": 3,
    "MaxUploadBytes": 26214400,
    "MaxDownloadBytes": 20971520,
    "FetchTimeoutSeconds": 30,
    "AllowPrivateNetworks": false
  },
  "Jobs": {
    "Provider": "InProcess",
    "Inngest": {
      "AppId": "knowledge-agent"
    }
  },
  "Search": {
    "Mode": "hybrid",
    "CandidatePool": 50,
    "RrfK": 60,
    "Rerank": true,
    "RerankCandidates": 30
  },
  "Agents": {
    "AppName": "Knowledge Agent",
    "MaxIterations": 8,
    "ResearcherMaxIterations": 6,
    "ResearcherEnabled": true,
    "AllowGeneralKnowledge": true,
    "GenerateTitles": true,
    "DefaultTopK": 6,
    "MaxTopK": 20,
    "History": {
      "Mode": "Compact",
      "KeepFullTurns": 0,
      "McpExcerptChars": 1000,
      "ReportExcerptChars": 1500,
      "OtherExcerptChars": 600
    }
  },
  "Help": {
    "RemoteUrl": ""
  },
  "AI": {
    "Providers": {
      "anthropic": {
        "Type": "anthropic",
        "ApiKey": "",
        "DefaultChatModel": "claude-opus-5-5",
        "DefaultRerankModel": "claude-haiku-5-5",
        "Settings": {
          "RefusalFallback": "default"
        }
      },
      "openai": {
        "Type": "openai",
        "ApiKey": "",
        "DefaultChatModel": "gpt-5-mini",
        "DefaultEmbeddingModel": "text-embedding-3-small",
        "DefaultEmbeddingDimensions": 1536,
        "DefaultRerankModel": "gpt-5-mini"
      },
      "voyage": {
        "Type": "voyage",
        "ApiKey": "",
        "DefaultEmbeddingModel": "voyage-4",
        "DefaultEmbeddingDimensions": 1024,
        "DefaultRerankModel": "rerank-2.5"
      },
      "ollama": {
        "Type": "ollama",
        "Endpoint": "",
        "DefaultChatModel": "qwen3",
        "DefaultEmbeddingModel": "nomic-embed-text"
      }
    },
    "Profiles": {
      "orchestrator": {
        "Provider": "auto",
        "Kind": "Chat",
        "ReasoningEffort": "medium",
        "ReasoningOutput": "summary",
        "MaxOutputTokens": 16000
      },
      "researcher": {
        "Provider": "auto",
        "Kind": "Chat",
        "ReasoningEffort": "medium",
        "MaxOutputTokens": 16000
      },
      "utility": {
        "Provider": "auto",
        "Kind": "Chat",
        "ReasoningEffort": "low",
        "MaxOutputTokens": 2000
      },
      "judge": {
        "Provider": "auto",
        "Kind": "Chat",
        "ReasoningEffort": "medium",
        "ReasoningOutput": "none",
        "MaxOutputTokens": 8000
      },
      "contextualizer": {
        "Provider": "auto",
        "Kind": "Chat",
        "ReasoningEffort": "low",
        "ReasoningOutput": "none",
        "MaxOutputTokens": 300
      },
      "rerank": {
        "Provider": "auto",
        "Kind": "Rerank",
        "ReasoningEffort": "low",
        "ReasoningOutput": "none",
        "MaxOutputTokens": 2000
      },
      "embedding": {
        "Provider": "auto",
        "Kind": "Embedding"
      }
    },
    "Telemetry": {
      "EnableSensitiveData": true
    }
  }
}
