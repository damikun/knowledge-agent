<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- KA_BUILD_SLOT builds into artifacts/slots/<slot> so that parallel builds do not collide. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(KA_BUILD_SLOT)' != ''">$(MSBuildThisFileDirectory)artifacts/slots/$(KA_BUILD_SLOT)</ArtifactsPath>
  </PropertyGroup>
</Project>
