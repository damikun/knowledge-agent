{
  "name": "knowledge-agent-web",
  "private": true,
  "version": "1.0.0",
  "description": "Knowledge Agent portal: chat with citations, sources, model profiles and prompts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build && npm run build:widget",
    "build:widget": "vite build --config vite.widget.config.ts && vite build --config vite.loader.config.ts",
    "widget:watch": "node scripts/widget-watch.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "shots": "node scripts/responsive-shots.mjs",
    "a11y": "node scripts/a11y-audit.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@xyflow/react": "12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
