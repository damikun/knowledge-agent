<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Inngest.Testing" />
    <PackageReference Include="Inngest.Testing.Containers" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.ClickHouse" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnowledgeAgent\KnowledgeAgent.csproj" />
    <ProjectReference Include="..\KnowledgeAgent.TestKit\KnowledgeAgent.TestKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\KnowledgeAgent.Api\appsettings.json" Link="api.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
